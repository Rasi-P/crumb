# Local development uses SQLite when DATABASE_URL is absent.
# Vercel requires all three variables, set only in server-side settings.
DATABASE_URL=
OWNER_PASSWORD=
SESSION_SECRET=

# Cake Studio image-to-3D. Without a key the studio reports
# "Image-to-3D service not configured"; nothing is simulated.
# Local development reads these from a .env file in the project root.
# IMAGE_TO_3D_PROVIDER=meshy   # or tripo; defaults to whichever key is set
MESHY_API_KEY=
# MESHY_AI_MODEL=latest
# MESHY_TARGET_POLYCOUNT=      # set to remesh to a fixed triangle budget
TRIPO_API_KEY=
# TRIPO_MODEL_VERSION=
# STUDIO_ASSET_PATH=.data/studio-assets   # local model/photo storage
# STUDIO_MAX_MODEL_MB=96
